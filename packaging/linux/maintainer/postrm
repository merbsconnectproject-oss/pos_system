#!/usr/bin/env bash
set -e

if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
  systemctl daemon-reload
fi

if [[ "${1:-}" == purge ]]; then
  echo "Radiance POS application data was preserved in /var/lib/radiance-pos."
  echo "Database pos_system and /etc/radiance-pos were also preserved."
fi

exit 0
