[Unit]
Description=Radiance POS API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pos
Group=pos
WorkingDirectory=/var/lib/pos-api
EnvironmentFile=/etc/pos-api/pos.env
ExecStart=/usr/bin/java -jar /opt/pos-api/pos-api.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pos-api

[Install]
WantedBy=multi-user.target
