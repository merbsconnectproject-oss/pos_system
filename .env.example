# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# Production reads the same names from Railway's variables.

DB_PASSWORD=your_local_postgres_password

# First run only. Once a user exists this is ignored; disable it after startup.
POS_BOOTSTRAP_ADMIN_ENABLED=true
POS_BOOTSTRAP_ADMIN_USERNAME=admin
POS_BOOTSTRAP_ADMIN_NAME=System Administrator
POS_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
POS_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
POS_BOOTSTRAP_ADMIN_PIN=1234
POS_BOOTSTRAP_OUTLET_CODE=RAD
POS_BOOTSTRAP_OUTLET_NAME=Radiance Lighting

# Optional local overrides — the defaults in application.yml already work.
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pos_system
# DB_USERNAME=giftedlabs
# LOG_LEVEL=DEBUG

# Self-service password reset through Resend's HTTPS API.
# Create a sending-only key and verify the domain used by RESEND_FROM.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Radiance POS <no-reply@example.com>
# AUTH_RESET_BASE_URL=https://pos.example.com/reset-password
