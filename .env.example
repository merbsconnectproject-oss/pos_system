# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# Production reads the same names from Railway's variables.

DB_PASSWORD=your_local_postgres_password

# First run only. Once a user exists this is ignored; disable it after startup.
POS_BOOTSTRAP_ADMIN_ENABLED=true
POS_BOOTSTRAP_ADMIN_USERNAME=admin
POS_BOOTSTRAP_ADMIN_NAME=System Administrator
POS_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
POS_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
POS_BOOTSTRAP_ADMIN_PIN=1234
POS_BOOTSTRAP_OUTLET_CODE=RAD   # BR-6 receipt segment: 2-6 letters or digits, no hyphen
POS_BOOTSTRAP_OUTLET_NAME=Radiance Lighting

# Optional local overrides — the defaults in application.yml already work.
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pos_system
# DB_USERNAME=giftedlabs
# LOG_LEVEL=DEBUG

# Self-service password reset through Resend's HTTPS API.
# Create a sending-only key and verify the domain used by RESEND_FROM.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Radiance POS <no-reply@example.com>
# AUTH_RESET_BASE_URL=https://pos.example.com/reset-password

# NFR-6 · NFR-7: backups. The schedule works out of the box and keeps copies in
# ./backups — but a copy on the counter PC's disk does not survive that disk
# failing, which is the risk this exists for. Fill these in and the settings
# screen turns green; leave them and it says "this machine only".
#
# Cloudflare R2: create a bucket, then an API token with Object Read & Write.
# The endpoint is https://<account-id>.r2.cloudflarestorage.com and the region
# stays "auto".
# POS_BACKUP_OFFSITE_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# POS_BACKUP_OFFSITE_BUCKET=radiance-pos-backups
# POS_BACKUP_OFFSITE_ACCESS_KEY_ID=xxxxxxxx
# POS_BACKUP_OFFSITE_SECRET_ACCESS_KEY=xxxxxxxx
# POS_BACKUP_OFFSITE_PREFIX=radiance   # one prefix per shop keeps the two apart
#
# Optional. The defaults are 15-minute dumps, 30-day retention.
# POS_BACKUP_ENABLED=true
# POS_BACKUP_INTERVAL=PT15M
# POS_BACKUP_DIRECTORY=backups
# POS_BACKUP_RETENTION=P30D
# POS_BACKUP_PG_DUMP=pg_dump        # full path on Windows, e.g. C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
#
# Restoring: ./restore.sh --list, then ./restore.sh backups/pos-<stamp>.dump
# It asks for the database name typed out, and dumps the current state first.
